---
import Lanyard from './lanyard/lanyard.tsx';
---

<section id="hero" class="relative w-full h-screen bg-black overflow-hidden">
  <!-- Background Grid Pattern (optional) -->
  <div class="absolute inset-0 bg-[linear-gradient(rgba(255,255,255,.02)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,.02)_1px,transparent_1px)] bg-size-[64px_64px]"></div>

  <div class="relative z-10 h-full flex flex-col md:flex-row items-center justify-between mt-50 md:mt-0 px-6 md:px-16 lg:px-24">
    <!-- Left Side - Content -->
    <div class="w-full md:w-1/2 space-y-8 text-left">
      <h1 class="text text-5xl md:text-7xl lg:text-8xl font-bold text-white leading-none tracking-tight" data-hero>
        FRONTEND<br/>
        DEVELOPER &<br/>
        FULL-STACK<br/>
        <span class="text-gray-500">CAPABLE</span>
      </h1>
      
      <p class="text-gray-400 text-sm md:text-base max-w-md leading-relaxed">
        expert in pixel-perfect<br/>
        websites development
      </p>
    </div>

    <!-- Right Side - Lanyard -->
    <div class="hidden relative w-full md:w-1/2 h-[60vh] md:h-full md:flex items-center justify-center">
      <div class="absolute inset-0">
        <Lanyard frontImage="/Danero.png" client:load />
      </div>
    </div>
  </div>

  <!-- Mobile Lanyard - Background -->
  <div class="md:hidden absolute inset-0">
    <Lanyard frontImage="/Danero.png" client:load />
  </div>
</section>

<script>
  import gsap from 'gsap';
  import { SplitText } from 'gsap/SplitText';

  gsap.registerPlugin(SplitText);

  const split = SplitText.create('.text', { type: 'chars' });

  gsap.from(split.chars, {
    opacity: 0.1,
    scale: 0.8,
    filter: 'blur(4px)',
    stagger: { each: 0.06, from: 'center' },
    duration: 0.4,
    ease: 'power2.out'
  });
</script>