---
import ProjectWheel from './ProjectWheel.tsx';
---

<section id="projects" class="relative w-full min-h-screen bg-black py-20">
  <div class="mx-auto px-6 md:px-16 lg:px-24">
    <!-- Section Header -->
    <div class="mb-16">
      <h2 class="text-5xl md:text-7xl font-bold text-white mb-4">PROJECTS</h2>
      <p class="text-gray-400 text-lg">Selected works & contributions</p>
    </div>

    <!-- Project Wheel Component -->
    <ProjectWheel client:load />
  </div>
</section>
