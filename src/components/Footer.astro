---
import TextPressure from './TextPressure';
---

<footer class="footer-section relative w-full bg-black overflow-hidden">
  <!-- TextPressure Background with Parallax -->
  <div class="hidden footer-bg absolute h-87.5 bottom-10 left-0 right-0 md:flex items-center justify-center opacity-5 pointer-events-none">
      <TextPressure
        client:load
        text="DANERO"
        fontFamily="Inter"
        fontUrl="https://fonts.googleapis.com/css2?family=Inter:wght@100;900"
        textColor="#FFFFFF"
        width={true}
        weight={true}
        flex={true}
        scale={true}
        minFontSize={250}
      />
  </div>
  <div class="md:hidden footer-bg absolute h-20 bottom-0 left-0 right-0 flex items-center justify-center opacity-5 pointer-events-none">
    <TextPressure
      client:load
      text="DANERO"
      fontFamily="Inter"
      fontUrl="https://fonts.googleapis.com/css2?family=Inter:wght@100;900"
      textColor="#FFFFFF"
      width={true}
      weight={true}
      flex={true}
      scale={true}
      minFontSize={70}
    />
  </div>
  <!-- Content -->
  <div class="footer-content relative z-10 mx-auto w-full max-w-7xl px-6 md:px-12 lg:px-16 py-20">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 w-full">
      <!-- Left Side - Quote & Social -->
      <div class="footer-left space-y-12 w-full max-w-xl">
        <!-- Quote -->
        <div class="space-y-6">
          <blockquote class="text-3xl md:text-4xl lg:text-5xl font-light text-white leading-tight break-words hyphens-auto w-full">
            "The goal is not to be better than the other man, but yourself."
          </blockquote>
        </div>

        <!-- Social Links -->
        <div class="space-y-6">
          <div class="flex flex-wrap gap-6">
            <a
              href="https://github.com/DaneroArama"
              target="_blank"
              rel="noopener noreferrer"
              class="shrink-0 w-12 h-12 flex items-center justify-center border border-white/20 rounded-full hover:border-white/40 hover:bg-white/5 transition-all duration-300"
              aria-label="GitHub"
            >
              <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
              </svg>
            </a>
            <a
              href="https://www.linkedin.com/in/aung-phone-myat-dev2323/"
              target="_blank"
              rel="noopener noreferrer"
              class="shrink-0 w-12 h-12 flex items-center justify-center border border-white/20 rounded-full hover:border-white/40 hover:bg-white/5 transition-all duration-300"
              aria-label="LinkedIn"
            >
              <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 24 24">
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
              </svg>
            </a>
          </div>

          <!-- Copyright -->
          <p class="text-gray-500 text-sm break-words">
            © 2026 Danero. All rights reserved.
          </p>
        </div>
      </div>

      <!-- Right Side - Contact Form -->
      <div class="footer-right space-y-6 w-full max-w-xl">
        <div class="mb-8">
          <h3 class="text-3xl md:text-4xl font-bold text-white mt-2">Get in Touch</h3>
          <p class="text-gray-400 mt-3">Have a project in mind? Let's talk.</p>
        </div>

        <form id="contact-form" class="space-y-5 w-full" novalidate>
          <!-- Name -->
          <div class="relative w-full">
            <div class="absolute inset-0 rounded-xl p-[1px] opacity-0 focus-within:opacity-100 transition-opacity duration-500 pointer-events-none">
              <div class="absolute inset-0 rounded-xl bg-gradient-to-r from-fuchsia-500 via-pink-500 to-rose-500"></div>
            </div>
            <input
              type="text"
              id="name"
              name="name"
              placeholder=" "
              autocomplete="name"
              required
              class="peer relative w-full px-5 pt-6 pb-2 bg-white/[0.03] border border-white/10 rounded-xl text-white placeholder-transparent focus:outline-none focus:border-transparent transition-all duration-500 focus:ring-3 focus:ring-white/10 hover:border-white/20"
            />
            <label for="name" class="absolute left-5 top-4 text-gray-400 text-base transition-all duration-300 pointer-events-none peer-placeholder-shown:top-4 peer-placeholder-shown:text-base peer-placeholder-shown:text-gray-400 peer-focus:top-2 peer-focus:text-xs peer-focus:text-white peer-[:not(:placeholder-shown)]:top-2 peer-[:not(:placeholder-shown)]:text-xs peer-[:not(:placeholder-shown)]:text-white">
              Your name
            </label>
            <p class="contact-error hidden mt-2 text-sm text-rose-400" data-for="name"></p>
          </div>

          <!-- Email -->
          <div class="relative w-full">
            <div class="absolute inset-0 rounded-xl p-[1px] opacity-0 focus-within:opacity-100 transition-opacity duration-500 pointer-events-none">
              <div class="absolute inset-0 rounded-xl bg-gradient-to-r from-fuchsia-500 via-pink-500 to-rose-500"></div>
            </div>
            <input
              type="email"
              id="email"
              name="email"
              placeholder=" "
              autocomplete="email"
              required
              class="peer relative w-full px-5 pt-6 pb-2 bg-white/[0.03] border border-white/10 rounded-xl text-white placeholder-transparent focus:outline-none focus:border-transparent transition-all duration-500 focus:ring-3 focus:ring-white/10 hover:border-white/20"
            />
            <label for="email" class="absolute left-5 top-4 text-gray-400 text-base transition-all duration-300 pointer-events-none peer-placeholder-shown:top-4 peer-placeholder-shown:text-base peer-placeholder-shown:text-gray-400 peer-focus:top-2 peer-focus:text-xs peer-focus:text-white peer-[:not(:placeholder-shown)]:top-2 peer-[:not(:placeholder-shown)]:text-xs peer-[:not(:placeholder-shown)]:text-white">
              Email address
            </label>
            <p class="contact-error hidden mt-2 text-sm text-rose-400" data-for="email"></p>
          </div>

          <!-- Message -->
          <div class="relative w-full">
            <div class="absolute inset-0 rounded-xl p-[1px] opacity-0 focus-within:opacity-100 transition-opacity duration-500 pointer-events-none">
              <div class="absolute inset-0 rounded-xl bg-gradient-to-r from-fuchsia-500 via-pink-500 to-rose-500"></div>
            </div>
            <textarea
              id="message"
              name="message"
              rows="5"
              placeholder=" "
              required
              class="peer relative w-full px-5 pt-6 pb-2 bg-white/[0.03] border border-white/10 rounded-xl text-white placeholder-transparent focus:outline-none focus:border-transparent transition-all duration-500 focus:ring-3 focus:ring-white/10 focus:bg-black/20 hover:border-white/20 resize-none backdrop-blur-sm min-h-35"
            ></textarea>
            <label for="message" class="absolute left-5 top-4 text-gray-400 text-base transition-all duration-300 pointer-events-none peer-placeholder-shown:top-4 peer-placeholder-shown:text-base peer-placeholder-shown:text-gray-400 peer-focus:top-2 peer-focus:text-xs peer-focus:text-white peer-[:not(:placeholder-shown)]:top-2 peer-[:not(:placeholder-shown)]:text-xs peer-[:not(:placeholder-shown)]:text-white">
              Tell me about your project
            </label>
            <p class="contact-error hidden mt-2 text-sm text-rose-400" data-for="message"></p>
          </div>

          <!-- Submit status banner -->
          <div id="contact-status" class="hidden rounded-xl p-4 text-sm font-medium"></div>

          <!-- Submit Button -->
          <button
            id="contact-submit"
            type="submit"
            class="group relative w-full px-6 py-4 rounded-xl overflow-hidden font-medium text-white hover:bg-white/5 hover:backdrop-blur-sm transition-all duration-500 hover:scale-[1.02] active:scale-[0.98] disabled:cursor-not-allowed disabled:opacity-60 disabled:hover:scale-100"
          >
            <span class="relative z-10 flex items-center justify-center gap-2">
              <span id="contact-submit-label">Send Message</span>
              <svg id="contact-spinner" class="hidden w-5 h-5 animate-spin text-white/90" viewBox="0 0 24 24" fill="none">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z"></path>
              </svg>
              <svg id="contact-send-icon" class="w-5 h-5 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 5l7 7-7 7" />
              </svg>
            </span>
          </button>
        </form>
      </div>
    </div>
  </div>
</footer>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  type SubmitState = {
    loading: boolean;
  };

  const state: SubmitState = { loading: false };

  function escapeHTML(input: string): string {
    return input
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  function showFieldError(field: 'name' | 'email' | 'message' | 'form', message: string) {
    const el = document.querySelector<HTMLElement>(`p.contact-error[data-for="${field}"]`);
    if (el) {
      el.textContent = message;
      el.classList.remove('hidden');
    }
  }

  function clearFieldErrors() {
    document.querySelectorAll('p.contact-error').forEach((el) => {
      el.classList.add('hidden');
      el.textContent = '';
    });
  }

  type BannerKind = 'success' | 'error' | 'info';
  function showBanner(kind: BannerKind, message: string) {
    const banner = document.getElementById('contact-status');
    if (!banner) return;
    banner.classList.remove('hidden');
    banner.className = banner.className.replace(/bg-[\w/.-]+|text-[\w/.-]+|ring-[\w/.-]+/g, '').trim();
    if (kind === 'success') {
      banner.classList.add('bg-emerald-500/10', 'text-emerald-300', 'ring-1', 'ring-inset', 'ring-emerald-500/30');
    } else if (kind === 'error') {
      banner.classList.add('bg-rose-500/10', 'text-rose-300', 'ring-1', 'ring-inset', 'ring-rose-500/30');
    } else {
      banner.classList.add('bg-white/5', 'text-gray-200', 'ring-1', 'ring-inset', 'ring-white/10');
    }
    banner.textContent = message;
  }

  function hideBanner() {
    const banner = document.getElementById('contact-status');
    if (banner) banner.classList.add('hidden');
  }

  function setLoading(loading: boolean) {
    state.loading = loading;
    const submit = document.getElementById('contact-submit') as HTMLButtonElement | null;
    const label = document.getElementById('contact-submit-label');
    const spinner = document.getElementById('contact-spinner');
    const sendIcon = document.getElementById('contact-send-icon');
    if (submit) submit.disabled = loading;
    if (label) label.textContent = loading ? 'Sending…' : 'Send Message';
    if (spinner) spinner.classList.toggle('hidden', !loading);
    if (sendIcon) sendIcon.classList.toggle('hidden', loading);
  }

  function validateForm(data: { name: string; email: string; message: string }): boolean {
    let ok = true;
    clearFieldErrors();

    if (!data.name || data.name.trim().length < 2) {
      showFieldError('name', 'Please enter your name (at least 2 characters).');
      ok = false;
    }
    if (!data.email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(data.email)) {
      showFieldError('email', 'Please enter a valid email address.');
      ok = false;
    }
    if (!data.message || data.message.trim().length < 5) {
      showFieldError('message', 'Please enter a message (at least 5 characters).');
      ok = false;
    }
    if (data.message && data.message.length > 10000) {
      showFieldError('message', 'Message is too long. Please keep it under 10,000 characters.');
      ok = false;
    }
    return ok;
  }

  async function submitForm(formEl: HTMLFormElement) {
    if (state.loading) return;

    const formData = new FormData(formEl);
    const payload = {
      name: String(formData.get('name') ?? '').trim(),
      email: String(formData.get('email') ?? '').trim(),
      message: String(formData.get('message') ?? '').trim(),
    };

    if (!validateForm(payload)) return;

    hideBanner();
    setLoading(true);

    try {
      const res = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });

      let json: { ok?: boolean; error?: string; field?: string; message?: string } = {};
      try {
        json = (await res.json()) as typeof json;
      } catch { /* ignore parse errors */ }

      if (!res.ok || !json.ok) {
        const msg =
          json?.error && typeof json.error === 'string'
            ? escapeHTML(json.error)
            : 'Something went wrong. Please check your connection and try again.';

        if (json?.field === 'name') showFieldError('name', msg);
        else if (json?.field === 'email') showFieldError('email', msg);
        else if (json?.field === 'message') showFieldError('message', msg);
        else showBanner('error', msg);

        if (res.status === 422 && json?.field) {
          const input = document.getElementById(json.field) as HTMLElement | null;
          if (input) input.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
        return;
      }

      // Success!
      showBanner('success', "Thanks, bro! Your message was sent — I'll get back to you soon. 🚀");
      formEl.reset();
      // Refocus name field for UX
      const nameInput = document.getElementById('name') as HTMLInputElement | null;
      if (nameInput) nameInput.focus({ preventScroll: true });
    } catch (err: unknown) {
      const msg =
        err instanceof TypeError && /failed to fetch|networkerror/i.test(err.message)
          ? 'Network error — please check your connection and try again.'
          : 'Unexpected error. Please try again later.';
      showBanner('error', msg);
    } finally {
      setLoading(false);
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    const footer = document.querySelector<HTMLElement>('.footer-section');
    const footerBg = document.querySelector<HTMLElement>('.footer-bg');
    const footerLeft = document.querySelector<HTMLElement>('.footer-left');
    const footerRight = document.querySelector<HTMLElement>('.footer-right');
    const _gsap = (globalThis as any).gsap || gsap;
    const _ScrollTrigger = (globalThis as any).ScrollTrigger || ScrollTrigger;

    if (footer && footerBg && footerLeft && footerRight && _gsap) {
      const ctx = _gsap.context(() => {
        _gsap.set([footerLeft, footerRight], {
          y: 100,
          opacity: 0
        });

        _gsap.set(footerBg, {
          y: -80
        });

        _gsap.to(footerBg, {
          y: 0,
          ease: 'none',
          scrollTrigger: {
            trigger: footer,
            start: 'top bottom',
            end: 'bottom bottom',
            scrub: 1
          }
        });

        const revealTl = _gsap.timeline({
          scrollTrigger: {
            trigger: footer,
            start: 'top 80%',
            toggleActions: 'play none none reverse'
          }
        });

        revealTl.to(footerLeft, {
          y: 0,
          opacity: 1,
          ease: 'power3.out',
          duration: 0.9
        }, 0);

        revealTl.to(footerRight, {
          y: 0,
          opacity: 1,
          ease: 'power3.out',
          duration: 0.9
        }, 0.15);
      }, footer);
    }

    if (_ScrollTrigger) {
      _ScrollTrigger.addEventListener('refresh', () => {});
      _ScrollTrigger.refresh();
    }

    // ---- Contact form submit ----
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    if (form) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        submitForm(form);
      });

      // Clear per-field error as user types
      ['name', 'email', 'message'].forEach((id) => {
        const el = document.getElementById(id) as HTMLInputElement | HTMLTextAreaElement | null;
        el?.addEventListener('input', () => {
          const errEl = document.querySelector<HTMLElement>(`p.contact-error[data-for="${id}"]`);
          if (errEl && !errEl.classList.contains('hidden')) {
            errEl.classList.add('hidden');
            errEl.textContent = '';
          }
        });
      });
    }
  });
</script>
