---
---

<section id="services" class="relative w-full min-h-screen bg-black py-20">
  <div class="mx-auto px-6 md:px-16 lg:px-24">
    <!-- Section Header -->
    <div class="mb-20">
      <h2 class="text-5xl md:text-7xl font-bold text-white mb-4">SERVICES</h2>
      <p class="text-gray-500 text-lg">What I can do for you</p>
    </div>

    <!-- Services List - Minimalist Style -->
    <div class="space-y-1">
      <!-- Service 1: Frontend Development -->
      <div class="group relative border-t border-white/5 py-8 hover:border-white/20 transition-all duration-500">
        <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-6">
          <div class="flex-1">
            <div class="flex items-center gap-4 mb-4">
              <span class="text-gray-600 font-mono text-sm">01</span>
              <h3 class="text-3xl md:text-4xl font-bold text-white group-hover:text-purple-400 transition-colors duration-300">
                Frontend Development
              </h3>
            </div>
            <p class="text-gray-400 text-lg leading-relaxed max-w-2xl mb-6">
              Building responsive and performant web applications using modern frameworks and technologies.
            </p>
            <div class="flex flex-wrap gap-3">
              <span class="text-gray-500 text-sm font-mono">React</span>
              <span class="text-gray-600">•</span>
              <span class="text-gray-500 text-sm font-mono">Next.js</span>
              <span class="text-gray-600">•</span>
              <span class="text-gray-500 text-sm font-mono">TypeScript</span>
              <span class="text-gray-600">•</span>
              <span class="text-gray-500 text-sm font-mono">Tailwind CSS</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Service 2: UI/UX Implementation -->
      <div class="group relative border-t border-white/5 py-8 hover:border-white/20 transition-all duration-500">
        <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-6">
          <div class="flex-1">
            <div class="flex items-center gap-4 mb-4">
              <span class="text-gray-600 font-mono text-sm">02</span>
              <h3 class="text-3xl md:text-4xl font-bold text-white group-hover:text-pink-400 transition-colors duration-300">
                UI/UX Implementation
              </h3>
            </div>
            <p class="text-gray-400 text-lg leading-relaxed max-w-2xl mb-6">
              Converting designs into pixel-perfect, production-ready code with focus on usability and aesthetics.
            </p>
            <div class="flex flex-wrap gap-3">
              <span class="text-gray-500 text-sm font-mono">Figma to Code</span>
              <span class="text-gray-600">•</span>
              <span class="text-gray-500 text-sm font-mono">Responsive Design</span>
              <span class="text-gray-600">•</span>
              <span class="text-gray-500 text-sm font-mono">Design Systems</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Service 3: API Integration -->
      <div class="group relative border-t border-white/5 py-8 hover:border-white/20 transition-all duration-500">
        <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-6">
          <div class="flex-1">
            <div class="flex items-center gap-4 mb-4">
              <span class="text-gray-600 font-mono text-sm">03</span>
              <h3 class="text-3xl md:text-4xl font-bold text-white group-hover:text-sky-400 transition-colors duration-300">
                API Integration
              </h3>
            </div>
            <p class="text-gray-400 text-lg leading-relaxed max-w-2xl mb-6">
              Seamless integration of RESTful APIs and GraphQL services for dynamic, data-driven applications.
            </p>
            <div class="flex flex-wrap gap-3">
              <span class="text-gray-500 text-sm font-mono">REST API</span>
              <span class="text-gray-600">•</span>
              <span class="text-gray-500 text-sm font-mono">GraphQL</span>
              <span class="text-gray-600">•</span>
              <span class="text-gray-500 text-sm font-mono">Real-time Data</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Service 4: Performance Optimization -->
      <div class="group relative border-t border-white/5 py-8 hover:border-white/20 transition-all duration-500 border-b">
        <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-6">
          <div class="flex-1">
            <div class="flex items-center gap-4 mb-4">
              <span class="text-gray-600 font-mono text-sm">04</span>
              <h3 class="text-3xl md:text-4xl font-bold text-white group-hover:text-amber-400 transition-colors duration-300">
                Performance Optimization
              </h3>
            </div>
            <p class="text-gray-400 text-lg leading-relaxed max-w-2xl mb-6">
              Improving web performance, ensuring cross-browser compatibility, and optimizing for search engines.
            </p>
            <div class="flex flex-wrap gap-3">
              <span class="text-gray-500 text-sm font-mono">Speed Optimization</span>
              <span class="text-gray-600">•</span>
              <span class="text-gray-500 text-sm font-mono">Cross-browser</span>
              <span class="text-gray-600">•</span>
              <span class="text-gray-500 text-sm font-mono">SEO</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
