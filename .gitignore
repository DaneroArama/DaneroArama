# ============================================================
#  Build artifacts — NEVER commit these
# ============================================================
dist/
.astro/
.vercel/
.netlify/
.output/
.serverless/
.svelte-kit/
.next/
.nuxt/

# ============================================================
#  Dependencies / package caches
# ============================================================
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.yarn-integrity
.npm
.eslintcache
.stylelintcache

# ============================================================
#  Lockfiles — keep or skip as you prefer (npm lockfile = keep, usually)
# ============================================================
# package-lock.json     # uncomment to skip — usually KEEP this committed
# yarn.lock             # same
# pnpm-lock.yaml        # same

# ============================================================
#  Environment variables & secrets — DO NOT COMMIT
# ============================================================
.env
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local
.env.*
!.env.example

# ============================================================
#  Logs & crash dumps
# ============================================================
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
yarn.lock

# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# ============================================================
#  OS / editor junk
# ============================================================
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.swp
*.swo
*~
.DS_Store
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ============================================================
#  Testing
# ============================================================
coverage/
*.lcov
.nyc_output

# ============================================================
#  Temporary / local only
# ============================================================
tmp/
temp/
.cache/
.parcel-cache/
.turbo/
