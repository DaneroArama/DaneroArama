---
---

<section id="about" class="about-section relative w-full min-h-screen bg-black py-20 overflow-hidden">
  <div class="mx-auto w-full px-6 md:px-16 lg:px-24">
    <!-- Section Header -->
    <div class="mb-20">
      <h2 class="about-title text-5xl md:text-7xl font-bold text-white mb-4">ABOUT ME</h2>
      <p class="text-gray-500 text-lg">Get to know me better</p>
    </div>

    <!-- Bio & Info -->
    <div class="grid grid-cols-1 lg:grid-cols-5 gap-12 lg:gap-20 mb-32">
      <!-- Left: Bio Summary -->
      <div class="about-bio lg:col-span-3 space-y-6">
        <h3 class="text-2xl md:text-3xl font-bold text-white leading-tight">
          Hey, I'm Aung Phone Myat — a Front-End Developer based in Yangon, Myanmar.
        </h3>
        <p class="about-summary text-gray-400 text-lg leading-relaxed">
          Front-End Developer with 1+ year of professional experience building responsive web applications using React, Next.js, TypeScript, and Tailwind CSS. Experienced in integrating RESTful APIs and GraphQL, creating reusable UI components, and collaborating with cross-functional teams to deliver scalable, user-focused applications. Passionate about modern frontend development and continuous learning.
        </p>
        <div class="flex flex-wrap gap-4 pt-4">
          <div class="flex items-center gap-3 px-4 py-3 rounded-xl bg-white/[0.03] border border-white/10">
            <svg class="w-5 h-5 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <span class="text-gray-300 text-sm">Yangon, Myanmar</span>
          </div>
          <a href="mailto:aungphonemyat2323@gmail.com" class="flex items-center gap-3 px-4 py-3 rounded-xl bg-white/[0.03] border border-white/10 hover:border-white/20 hover:bg-white/5 transition-all duration-300">
            <svg class="w-5 h-5 text-pink-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            <span class="text-gray-300 text-sm">aungphonemyat2323@gmail.com</span>
          </a>
        </div>
      </div>

      <!-- Right: Quick Stats -->
      <div class="about-stats lg:col-span-2 space-y-6">
        <div class="grid grid-cols-2 gap-6">
          <div class="about-stat p-6 rounded-2xl bg-white/[0.03] border border-white/10">
            <div class="text-4xl md:text-5xl font-bold text-white mb-2">1+</div>
            <div class="text-gray-500 text-sm font-mono">Years Experience</div>
          </div>
          <div class="about-stat p-6 rounded-2xl bg-white/[0.03] border border-white/10">
            <div class="text-4xl md:text-5xl font-bold text-white mb-2">10+</div>
            <div class="text-gray-500 text-sm font-mono">Projects Shipped</div>
          </div>
          <div class="about-stat p-6 rounded-2xl bg-white/[0.03] border border-white/10">
            <div class="text-4xl md:text-5xl font-bold text-white mb-2">3</div>
            <div class="text-gray-500 text-sm font-mono">Roles Active</div>
          </div>
          <div class="about-stat p-6 rounded-2xl bg-white/[0.03] border border-white/10">
            <div class="text-4xl md:text-5xl font-bold text-white mb-2">3</div>
            <div class="text-gray-500 text-sm font-mono">Languages</div>
          </div>
        </div>
      </div>
    </div>

    <!-- Experience Section -->
    <div class="mb-32">
      <div class="mb-12 flex items-center gap-4">
        <span class="text-gray-600 font-mono text-sm">01</span>
        <h3 class="experience-title text-3xl md:text-5xl font-bold text-white">EXPERIENCE</h3>
      </div>

      <div class="space-y-1">
        <!-- MyJobs.com.mm -->
        <div class="experience-item group relative py-10 transition-all duration-500">
          <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-6">
            <div class="md:w-1/4">
              <div class="text-amber-400 text-sm font-mono mb-2">Ongoing</div>
              <div class="text-gray-600 text-sm">Yangon, Myanmar</div>
            </div>
            <div class="flex-1">
              <div class="flex flex-wrap items-start justify-between gap-4 mb-4">
                <div>
                  <h4 class="text-2xl md:text-3xl font-bold text-white group-hover:text-amber-400 transition-colors duration-300 mb-1">
                    Front End Developer
                  </h4>
                  <p class="text-gray-500 font-mono text-sm">MyJobs.com.mm · Part-time</p>
                </div>
              </div>
              <ul class="space-y-3 text-gray-400 leading-relaxed">
                <li class="flex gap-3">
                  <span class="text-gray-600 mt-1.5">▸</span>
                  <span>Developed and maintained responsive web application using React, TypeScript, Next.js, and Tailwind CSS.</span>
                </li>
                <li class="flex gap-3">
                  <span class="text-gray-600 mt-1.5">▸</span>
                  <span>Implemented new features and enhanced existing modules based on business requirements.</span>
                </li>
                <li class="flex gap-3">
                  <span class="text-gray-600 mt-1.5">▸</span>
                  <span>Integrated RESTful APIs to deliver dynamic, data-driven user experiences.</span>
                </li>
                <li class="flex gap-3">
                  <span class="text-gray-600 mt-1.5">▸</span>
                  <span>Optimized application performance, responsiveness, and cross-browser compatibility.</span>
                </li>
              </ul>
            </div>
          </div>
        </div>

        <!-- EzyProduct -->
        <div class="experience-item group relative border-t border-white/5 py-10 hover:border-white/20 transition-all duration-500">
          <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-6">
            <div class="md:w-1/4">
              <div class="text-pink-400 text-sm font-mono mb-2">08/2025 - 07/2026</div>
            </div>
            <div class="flex-1">
              <div class="flex flex-wrap items-start justify-between gap-4 mb-4">
                <div>
                  <h4 class="text-2xl md:text-3xl font-bold text-white group-hover:text-pink-400 transition-colors duration-300 mb-1">
                    Front End Developer
                  </h4>
                  <p class="text-gray-500 font-mono text-sm">EzyProduct · Project Based</p>
                </div>
              </div>
              <ul class="space-y-3 text-gray-400 leading-relaxed">
                <li class="flex gap-3">
                  <span class="text-gray-600 mt-1.5">▸</span>
                  <span>Developed and maintained both the Admin Dashboard and Merchant Web Application using modern frontend technologies.</span>
                </li>
                <li class="flex gap-3">
                  <span class="text-gray-600 mt-1.5">▸</span>
                  <span>Built responsive, user-friendly interfaces from Figma designs with a focus on usability and performance.</span>
                </li>
                <li class="flex gap-3">
                  <span class="text-gray-600 mt-1.5">▸</span>
                  <span>Created reusable UI components to improve consistency and maintainability across both applications.</span>
                </li>
                <li class="flex gap-3">
                  <span class="text-gray-600 mt-1.5">▸</span>
                  <span>Integrated RESTful APIs and GraphQL services for authentication, dashboard analytics, merchant management, and business workflows.</span>
                </li>
              </ul>
            </div>
          </div>
        </div>

        <!-- UXMM -->
        <div class="experience-item group relative border-t border-white/5 py-10 hover:border-white/20 transition-all duration-500">
          <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-6">
            <div class="md:w-1/4">
              <div class="text-sky-400 text-sm font-mono mb-2">02/2025 - Present</div>
              <div class="text-gray-600 text-sm">&nbsp;</div>
            </div>
            <div class="flex-1">
              <div class="flex flex-wrap items-start justify-between gap-4 mb-4">
                <div>
                  <h4 class="text-2xl md:text-3xl font-bold text-white group-hover:text-sky-400 transition-colors duration-300 mb-1">
                    Development Specialist
                  </h4>
                  <p class="text-gray-500 font-mono text-sm">UXMM · Volunteer</p>
                </div>
              </div>
              <ul class="space-y-3 text-gray-400 leading-relaxed">
                <li class="flex gap-3">
                  <span class="text-gray-600 mt-1.5">▸</span>
                  <span>Developed and delivered multiple web applications supporting the organization's community initiatives, educational programs, and events.</span>
                </li>
                <li class="flex gap-3">
                  <span class="text-gray-600 mt-1.5">▸</span>
                  <span>Participated in planning, feature implementation, testing, and deployment of community projects.</span>
                </li>
                <li class="flex gap-3">
                  <span class="text-gray-600 mt-1.5">▸</span>
                  <span>Built and maintained responsive, user-friendly interfaces while collaborating closely with UI/UX designers and cross-functional teams.</span>
                </li>
                <li class="flex gap-3">
                  <span class="text-gray-600 mt-1.5">▸</span>
                  <span>Implemented reusable components and scalable frontend architecture to improve development efficiency and maintainability.</span>
                </li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Skills & Tech Stack -->
    <div class="mb-8">
      <div class="mb-12 flex items-center gap-4">
        <span class="text-gray-600 font-mono text-sm">02</span>
        <h3 class="skills-title text-3xl md:text-5xl font-bold text-white">TECH STACK</h3>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <!-- Frontend -->
        <div class="skills-card p-8 rounded-2xl bg-white/[0.03] border border-white/10 hover:border-white/20 transition-all duration-500">
          <h4 class="text-xl font-bold text-purple-400 mb-6 font-mono text-sm uppercase tracking-wider">Frontend</h4>
          <div class="flex flex-wrap gap-3">
            <span class="skill-tag px-4 py-2 rounded-lg bg-white/[0.02] border border-white/10 text-gray-300 text-sm font-mono hover:border-purple-400/50 hover:text-purple-300 transition-all duration-300">React</span>
            <span class="skill-tag px-4 py-2 rounded-lg bg-white/[0.02] border border-white/10 text-gray-300 text-sm font-mono hover:border-purple-400/50 hover:text-purple-300 transition-all duration-300">Next.js</span>
            <span class="skill-tag px-4 py-2 rounded-lg bg-white/[0.02] border border-white/10 text-gray-300 text-sm font-mono hover:border-purple-400/50 hover:text-purple-300 transition-all duration-300">Astro</span>
            <span class="skill-tag px-4 py-2 rounded-lg bg-white/[0.02] border border-white/10 text-gray-300 text-sm font-mono hover:border-purple-400/50 hover:text-purple-300 transition-all duration-300">Vite</span>
            <span class="skill-tag px-4 py-2 rounded-lg bg-white/[0.02] border border-white/10 text-gray-300 text-sm font-mono hover:border-purple-400/50 hover:text-purple-300 transition-all duration-300">TypeScript</span>
            <span class="skill-tag px-4 py-2 rounded-lg bg-white/[0.02] border border-white/10 text-gray-300 text-sm font-mono hover:border-purple-400/50 hover:text-purple-300 transition-all duration-300">Tailwind CSS</span>
            <span class="skill-tag px-4 py-2 rounded-lg bg-white/[0.02] border border-white/10 text-gray-300 text-sm font-mono hover:border-purple-400/50 hover:text-purple-300 transition-all duration-300">Three.js</span>
            <span class="skill-tag px-4 py-2 rounded-lg bg-white/[0.02] border border-white/10 text-gray-300 text-sm font-mono hover:border-purple-400/50 hover:text-purple-300 transition-all duration-300">GSAP</span>
          </div>
        </div>

        <!-- Backend & APIs -->
        <div class="skills-card p-8 rounded-2xl bg-white/[0.03] border border-white/10 hover:border-white/20 transition-all duration-500">
          <h4 class="text-xl font-bold text-fuchsia-400 mb-6 font-mono text-sm uppercase tracking-wider">Backend & APIs</h4>
          <div class="flex flex-wrap gap-3">
            <span class="skill-tag px-4 py-2 rounded-lg bg-white/[0.02] border border-white/10 text-gray-300 text-sm font-mono hover:border-fuchsia-400/50 hover:text-fuchsia-300 transition-all duration-300">REST API</span>
            <span class="skill-tag px-4 py-2 rounded-lg bg-white/[0.02] border border-white/10 text-gray-300 text-sm font-mono hover:border-fuchsia-400/50 hover:text-fuchsia-300 transition-all duration-300">GraphQL</span>
            <span class="skill-tag px-4 py-2 rounded-lg bg-white/[0.02] border border-white/10 text-gray-300 text-sm font-mono hover:border-fuchsia-400/50 hover:text-fuchsia-300 transition-all duration-300">Convex DB</span>
            <span class="skill-tag px-4 py-2 rounded-lg bg-white/[0.02] border border-white/10 text-gray-300 text-sm font-mono hover:border-fuchsia-400/50 hover:text-fuchsia-300 transition-all duration-300">Supabase</span>
            <span class="skill-tag px-4 py-2 rounded-lg bg-white/[0.02] border border-white/10 text-gray-300 text-sm font-mono hover:border-fuchsia-400/50 hover:text-fuchsia-300 transition-all duration-300">Git</span>
            <span class="skill-tag px-4 py-2 rounded-lg bg-white/[0.02] border border-white/10 text-gray-300 text-sm font-mono hover:border-fuchsia-400/50 hover:text-fuchsia-300 transition-all duration-300">Figma</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Education & Languages -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-12">
      <!-- Education -->
      <div class="edu-card p-8 rounded-2xl bg-white/[0.03] border border-white/10 hover:border-white/20 transition-all duration-500">
        <h4 class="text-xl font-bold text-emerald-400 mb-6 font-mono text-sm uppercase tracking-wider">Education</h4>
        <div class="space-y-3">
          <h5 class="text-xl font-bold text-white">Dagon University</h5>
          <p class="text-gray-400">Computer Science · Dagon, Yangon</p>
          <p class="text-gray-600 text-sm font-mono">Expected 08/2026</p>
        </div>
      </div>

      <!-- Languages -->
      <div class="lang-card p-8 rounded-2xl bg-white/[0.03] border border-white/10 hover:border-white/20 transition-all duration-500">
        <h4 class="text-xl font-bold text-rose-400 mb-6 font-mono text-sm uppercase tracking-wider">Languages</h4>
        <div class="space-y-4">
          <div class="flex justify-between items-center">
            <div>
              <p class="text-white font-medium">Myanmar</p>
              <p class="text-gray-500 text-sm">Native</p>
            </div>
            <div class="flex-1 mx-6 h-1.5 rounded-full bg-white/5 overflow-hidden">
              <div class="lang-bar h-full w-full rounded-full bg-gradient-to-r from-rose-500 to-pink-500"></div>
            </div>
          </div>
          <div class="flex justify-between items-center">
            <div>
              <p class="text-white font-medium">English</p>
              <p class="text-gray-500 text-sm">Professional Working Proficiency</p>
            </div>
            <div class="flex-1 mx-6 h-1.5 rounded-full bg-white/5 overflow-hidden">
              <div class="lang-bar h-full w-4/5 rounded-full bg-gradient-to-r from-rose-500 to-pink-500"></div>
            </div>
          </div>
          <div class="flex justify-between items-center">
            <div>
              <p class="text-white font-medium">Japanese</p>
              <p class="text-gray-500 text-sm">JLPT N</p>
            </div>
            <div class="flex-1 mx-6 h-1.5 rounded-full bg-white/5 overflow-hidden">
              <div class="lang-bar h-full w-2/5 rounded-full bg-gradient-to-r from-rose-500 to-pink-500"></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const _gsap = (globalThis as any).gsap || gsap;
  const _ScrollTrigger = (globalThis as any).ScrollTrigger || ScrollTrigger;

  if (_gsap && _ScrollTrigger) {
    const ctx = _gsap.context(() => {
      _gsap.set('.about-title', { opacity: 0, y: 40 });
      _gsap.to('.about-title', {
        opacity: 1,
        y: 0,
        ease: 'power3.out',
        duration: 0.9,
        scrollTrigger: {
          trigger: '.about-section',
          start: 'top 80%',
          toggleActions: 'play none none reverse'
        }
      });

      _gsap.set('.about-bio', { opacity: 0, y: 40 });
      _gsap.to('.about-bio', {
        opacity: 1,
        y: 0,
        ease: 'power3.out',
        duration: 0.9,
        delay: 0.15,
        scrollTrigger: {
          trigger: '.about-bio',
          start: 'top 85%',
          toggleActions: 'play none none reverse'
        }
      });

      _gsap.utils.toArray('.about-stat').forEach((stat: any, i: number) => {
        _gsap.set(stat, { opacity: 0, y: 30, scale: 0.95 });
        _gsap.to(stat, {
          opacity: 1,
          y: 0,
          scale: 1,
          ease: 'back.out(1.7)',
          duration: 0.7,
          delay: i * 0.1,
          scrollTrigger: {
            trigger: '.about-stats',
            start: 'top 85%',
            toggleActions: 'play none none reverse'
          }
        });
      });

      _gsap.set('.experience-title', { opacity: 0, y: 30 });
      _gsap.to('.experience-title', {
        opacity: 1,
        y: 0,
        ease: 'power3.out',
        duration: 0.8,
        scrollTrigger: {
          trigger: '.experience-title',
          start: 'top 85%',
          toggleActions: 'play none none reverse'
        }
      });

      _gsap.utils.toArray('.experience-item').forEach((item: any, i: number) => {
        _gsap.set(item, { opacity: 0, y: 40 });
        _gsap.to(item, {
          opacity: 1,
          y: 0,
          ease: 'power3.out',
          duration: 0.8,
          delay: i * 0.15,
          scrollTrigger: {
            trigger: item,
            start: 'top 85%',
            toggleActions: 'play none none reverse'
          }
        });
      });

      _gsap.set('.skills-title', { opacity: 0, y: 30 });
      _gsap.to('.skills-title', {
        opacity: 1,
        y: 0,
        ease: 'power3.out',
        duration: 0.8,
        scrollTrigger: {
          trigger: '.skills-title',
          start: 'top 85%',
          toggleActions: 'play none none reverse'
        }
      });

      _gsap.utils.toArray('.skills-card').forEach((card: any, i: number) => {
        _gsap.set(card, { opacity: 0, y: 40 });
        _gsap.to(card, {
          opacity: 1,
          y: 0,
          ease: 'power3.out',
          duration: 0.8,
          delay: i * 0.15,
          scrollTrigger: {
            trigger: card,
            start: 'top 85%',
            toggleActions: 'play none none reverse'
          }
        });
      });

      _gsap.utils.toArray('.skill-tag').forEach((tag: any, i: number) => {
        _gsap.set(tag, { opacity: 0, y: 20 });
        _gsap.to(tag, {
          opacity: 1,
          y: 0,
          ease: 'power3.out',
          duration: 0.5,
          delay: i * 0.03,
          scrollTrigger: {
            trigger: '.skills-card',
            start: 'top 80%',
            toggleActions: 'play none none reverse'
          }
        });
      });

      _gsap.set('.edu-card', { opacity: 0, x: -40 });
      _gsap.to('.edu-card', {
        opacity: 1,
        x: 0,
        ease: 'power3.out',
        duration: 0.8,
        scrollTrigger: {
          trigger: '.edu-card',
          start: 'top 85%',
          toggleActions: 'play none none reverse'
        }
      });

      _gsap.set('.lang-card', { opacity: 0, x: 40 });
      _gsap.to('.lang-card', {
        opacity: 1,
        x: 0,
        ease: 'power3.out',
        duration: 0.8,
        scrollTrigger: {
          trigger: '.lang-card',
          start: 'top 85%',
          toggleActions: 'play none none reverse'
        }
      });

      _gsap.set('.lang-bar', { scaleX: 0, transformOrigin: 'left center' });
      _gsap.to('.lang-bar', {
        scaleX: 1,
        ease: 'power2.out',
        duration: 1.2,
        delay: 0.3,
        scrollTrigger: {
          trigger: '.lang-card',
          start: 'top 80%',
          toggleActions: 'play none none reverse'
        }
      });
    });
  }
</script>
